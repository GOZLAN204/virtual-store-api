{
  "info": {
    "name": "Virtual Store API",
    "description": "Postman collection for Virtual Store REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Israel Israeli\",\n  \"phone\": \"0501234567\",\n  \"email\": \"israel@test.com\",\n  \"address\": \"Tel Aviv\"\n}"
            },
            "url": "{{baseUrl}}/users/add"
          }
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/All"
          }
        },
        {
          "name": "Get User By Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users?id={{userId}}"
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{userId}}\",\n  \"address\": \"Jerusalem\"\n}"
            },
            "url": "{{baseUrl}}/users/edit"
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{userId}}\"\n}"
            },
            "url": "{{baseUrl}}/users/delete"
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Electronics\"\n}"
            },
            "url": "{{baseUrl}}/category/add"
          }
        },
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/category/All"
          }
        },
        {
          "name": "Get Category By Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/category?id={{categoryId}}"
          }
        },
        {
          "name": "Product Count By Category",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/category/productCount"
          }
        },
        {
          "name": "Update Category",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{categoryId}}\",\n  \"name\": \"Home Electronics\"\n}"
            },
            "url": "{{baseUrl}}/category/edit"
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop\",\n  \"description\": \"Gaming laptop\",\n  \"price\": 4500,\n  \"stock\": 10,\n  \"category_id\": \"{{categoryId}}\"\n}"
            },
            "url": "{{baseUrl}}/products/add"
          }
        },
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/All"
          }
        },
        {
          "name": "Get Product By Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products?id={{productId}}"
          }
        },
        {
          "name": "Products By Category",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/byCategory?category_id={{categoryId}}"
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{productId}}\",\n  \"price\": 4200,\n  \"stock\": 8\n}"
            },
            "url": "{{baseUrl}}/products/edit"
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{productId}}\"\n}"
            },
            "url": "{{baseUrl}}/products/delete"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{userId}}\",\n  \"products\": [\n    {\n      \"product_id\": \"{{productId}}\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/orders/add"
          }
        },
        {
          "name": "Get All Orders",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/orders/All"
          }
        },
        {
          "name": "Get Order By Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/orders?id={{orderId}}"
          }
        },
        {
          "name": "Get Orders By User",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/orders/user?user_id={{userId}}"
          }
        }
      ]
    }
  ]
}
